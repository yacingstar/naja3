NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Meta (Facebook/Instagram) Pixel ID. Leave blank to disable tracking —
# unset locally on purpose so dev never fires events into the ad account.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token (server-side Purchase events).
# NOT NEXT_PUBLIC_ — this key can write events into the ad account.
# Events Manager -> your pixel -> Settings -> Conversions API -> generate.
META_CAPI_ACCESS_TOKEN=

# Optional: routes CAPI events to Events Manager -> Test Events instead of
# real reporting. Leave blank except when verifying. Codes rotate.
META_CAPI_TEST_EVENT_CODE=
