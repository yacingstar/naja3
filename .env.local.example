NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Meta (Facebook/Instagram) Pixel ID. Leave blank to disable tracking —
# unset locally on purpose so dev never fires events into the ad account.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token (server-side Purchase events).
# NOT NEXT_PUBLIC_ — this key can write events into the ad account.
# Events Manager -> your pixel -> Settings -> Conversions API -> generate.
META_CAPI_ACCESS_TOKEN=

# Optional: routes CAPI events to Events Manager -> Test Events instead of
# real reporting. Leave blank except when verifying. Codes rotate.
META_CAPI_TEST_EVENT_CODE=

# Telegram bot token — new-order notifications to the shop owner's phone.
# NOT NEXT_PUBLIC_ — anyone holding this can send as the bot.
# Create the bot with @BotFather in Telegram (/newbot). Blank = no
# notifications, which is the right default for local dev.
TELEGRAM_BOT_TOKEN=

# The chat the notification is sent to. The owner must press Start in the
# bot's chat first — a bot cannot message someone who has never messaged it —
# then read the id from https://api.telegram.org/bot<TOKEN>/getUpdates at
# result[0].message.chat.id.
TELEGRAM_CHAT_ID=

# ── WhatsApp (Meta Cloud API) — a second new-order channel, beside Telegram ──
#
# Same order, same message, different app. Telegram is the one that always
# works; this one is added because the owner lives in WhatsApp.
#
# Setup, in order. It is fiddly, and steps 2 and 3 are the ones that fail
# silently:
#   1. developers.facebook.com → create a Business app → add the WhatsApp
#      product. Note the phone *number ID* (a numeric id, not the number).
#   2. Register a number with the API. ⚠ It cannot be a number already used in
#      the WhatsApp app — registering it takes it off the phone. Use a second
#      SIM or a virtual number: it is the sender, and the owner keeps her own
#      WhatsApp untouched.
#   3. The owner must write to the business number once, or Meta refuses to
#      deliver as "not opted in".
#   4. Create the template named below — category Utility, language fr, body
#      and parameters are recorded in CONTEXT.md (round 46) — and wait for
#      approval. Nothing is delivered outside a 24h window without an approved
#      template, and a server-initiated notification is always outside it.
#   5. Generate a *permanent* System User token. The dashboard's temporary one
#      expires in 24h and the notifications stop with it, quietly.
#
# All blank = feature off, the same convention as Telegram, the pixel and CAPI.

# NOT NEXT_PUBLIC_ — anyone holding this can send as the business.
WHATSAPP_TOKEN=

# The phone number ID from step 1.
WHATSAPP_PHONE_NUMBER_ID=

# The owner's own WhatsApp, in any usual Algerian form (0555 12 34 56, or
# +213555123456) — normalizePhone converts it to what the API wants, so there
# is no second format to remember.
WHATSAPP_TO=

# The approved template's exact name, character for character. A mismatch is
# answered with 132001 and nothing is delivered.
WHATSAPP_TEMPLATE_NAME=

# Its language code. Defaults to fr when unset.
WHATSAPP_TEMPLATE_LANG=fr
